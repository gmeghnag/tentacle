{
  "manifest_version": 3,
  "name": "tentacle browser",
  "version": "0.1.0",
  "description": "Lets tentacle see the tabs of its own group in this Chrome, and nothing else.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "tabGroups",
    "scripting",
    "webRequest",
    "debugger",
    "storage"
  ],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/page.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": { "default_title": "tentacle browser", "default_popup": "src/popup.html" }
}
