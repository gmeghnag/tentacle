# Caddy site block for session apps — apps.tentacle.so and *.apps.tentacle.so
# (docs/feat/session-apps-host.md; runbook: docs/ops/apps-host-deploy.md)
#
# NOT APPLIED by any executor. Include it from the host's main Caddyfile:
#
#   import /etc/caddy/apps.tentacle.so.caddy
#
# A wildcard certificate is issued through DNS-01 only, so Caddy needs a DNS
# provider module (runbook §4). Verified on the tentacle.so box 2026-11-26:
# Caddy 2.11.9 built with github.com/caddy-dns/hetzner/v2 (Hetzner Cloud DNS API,
# a token from the new Hetzner Console) — the stock image will NOT accept this file.
# The box's container env names the token HETZNER_API_TOKEN; the first attempt
# without a propagation delay failed («No TXT record found»), hence the delay.

*.apps.tentacle.so, apps.tentacle.so {
	tls {
		dns hetzner {env.HETZNER_API_TOKEN}
		propagation_delay 90s
		propagation_timeout 5m
		resolvers 1.1.1.1 8.8.8.8
	}
	request_body {
		max_size 10MiB # = maxAppBytes (MiB, not MB = 10^6); the process re-checks
	}
	header {
		# This name only: no includeSubDomains, no preload.
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	reverse_proxy 127.0.0.1:4200 {
		# REPLACE the client's header: the process takes the right-most hop.
		header_up X-Forwarded-For {remote_host}
		# Live apps stream (server-sent events, long responses): pass bytes on at once.
		flush_interval -1
	}
	# Cookies pass: a LIVE app needs them (docs/feat/session-apps-container-ports.md
	# Q5). The process sets none on static and control responses (its tests pin
	# that) and drops a `Domain` cookie from a live app.
	# No `log` directive: visitor access is not logged (privacy).
}
