# tentacle-relay — the mobile relay (docs/feat/mobile-relay.md R2, deployed by R7)
#
# NOT APPLIED by any executor: install this by hand, following
# docs/ops/relay-deploy.md (slice D, owner-approved). It carries no secret; when
# APNs push lands (task 16 / docs/feat/mobile-push.md P10) the `.p8` arrives as a
# systemd credential, never as a file next to the binary or a flag in argv (argv
# is world-readable in `ps`).
#
# The relay speaks ws:// on loopback only: Caddy terminates TLS in front of it
# (deploy/Caddyfile.relay) and the daemon dials wss://relay.tentacle.so.

[Unit]
Description=tentacle mobile relay (a stateless, end-to-end-encrypted splicer)
Documentation=https://github.com/gmeghnag/tentacle/blob/main/docs/ops/relay-deploy.md
After=network-online.target
Wants=network-online.target
# A crash loop must still be visible: 5 crashes in 30 s parks the unit, and an
# operator sees `failed` instead of an endless restart. These belong in [Unit] —
# systemd ignores (and warns about) this pair in [Service].
StartLimitIntervalSec=30s
StartLimitBurst=5

[Service]
Type=simple
User=relay
Group=relay
# The binary only; --host/--port are the defaults `main.ts` already applies, but
# they are stated so this unit is the one place the deploy's bind address lives
# (deploy.test.ts asserts `main.ts` parses exactly these flags at exactly these
# values, so the unit cannot drift into an ExecStart that exits 1 on every boot).
#
# `--trust-proxy` IS REQUIRED HERE. Behind Caddy (`deploy/Caddyfile.relay`) the
# direct peer is 127.0.0.1, so without it the relay's per-IP abuse limits are ONE
# bucket for the whole world: one client could take all 16 phone sockets and a
# `hello` flood could lock EVERY daemon out of re-registering. With it the relay
# takes the real client from `X-Forwarded-For` — only from a loopback peer, only
# the right-most untrusted hop (`client-ip.ts`) — so every limit applies per
# client again and NOTHING here overrides them.
#
# So the three per-IP flags are deliberately ABSENT and the per-client defaults
# of `relay-core.ts` apply: 30 dials/min, 16 concurrent phone sockets and 10
# registrations/min per address, plus 32 registered ids per address
# (`--max-ids-per-ip`). The owner can raise any of them for a large carrier NAT
# without a rebuild — the flags are all still there (runbook §9).
ExecStart=/opt/tentacle-relay/tentacle-relay --host 127.0.0.1 --port 4100 --trust-proxy

Restart=always
RestartSec=2s
TimeoutStopSec=10s

# Sandbox. The relay serves sockets and writes nothing: no state, no session, no
# secret (Owner Q4). So every write path can be closed, and the service keeps no
# capability at all (it binds loopback on a port > 1024).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
# NOT set, deliberately: MemoryDenyWriteExecute and SystemCallFilter=@system-service.
# The binary is Bun, i.e. JavaScriptCore, which JIT-compiles — it maps
# writable-then-executable memory by design. `MemoryDenyWriteExecute=yes` would
# make the relay die on its first compiled frame, and a syscall allowlist tuned on
# a non-JIT service tends to block the same thing (membarrier). Both are the kind
# of hardening that looks good in a unit and breaks the service on the host only.

# One process, bounded: a hostile flood costs the relay's own memory, never the
# host's (the per-IP and per-id limits are the real bound — `relay-core.ts`; this
# is the last resort).
MemoryMax=512M
TasksMax=512

# The journal is the only log. One line per event, id prefixes only, never a
# secret or a payload (`apps/relay/src/server.ts`).
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tentacle-relay

[Install]
WantedBy=multi-user.target
