# tentacle-relay — the mobile relay (docs/feat/mobile-relay.md R2, deployed by R7)
#
# NOT APPLIED by any executor: install this by hand, following
# docs/ops/relay-deploy.md (slice D, owner-approved). It carries no secret; when
# APNs push lands (task 16 / docs/feat/mobile-push.md P10) the `.p8` arrives as a
# systemd credential in a DROP-IN (`deploy/relay.service.d/apns.conf`), never as a
# file next to the binary or a flag in argv (argv is world-readable in `ps`).
# Push is therefore absent from THIS file on purpose: the base unit has to start
# on a host with no Apple key at all (F4, and review round 1's finding 1 — with
# `Restart=always`, an ExecStart the binary refuses is a crash loop that takes
# every phone off the relay).
#
# The relay speaks ws:// on loopback only: Caddy terminates TLS in front of it
# (deploy/Caddyfile.relay) and the daemon dials wss://relay.tentacle.so.

[Unit]
Description=tentacle mobile relay (a stateless, end-to-end-encrypted splicer)
Documentation=https://github.com/gmeghnag/tentacle/blob/main/docs/ops/relay-deploy.md
After=network-online.target
Wants=network-online.target
# A crash loop must still be visible: 5 crashes in 30 s parks the unit, and an
# operator sees `failed` instead of an endless restart. These belong in [Unit] —
# systemd ignores (and warns about) this pair in [Service].
StartLimitIntervalSec=30s
StartLimitBurst=5

[Service]
Type=simple
User=relay
Group=relay
# The binary only; --host/--port are the defaults `main.ts` already applies, but
# they are stated so this unit is the one place the deploy's bind address lives
# (deploy.test.ts asserts `main.ts` parses exactly these flags at exactly these
# values, so the unit cannot drift into an ExecStart that exits 1 on every boot).
#
# THE THREE PER-IP LIMITS ARE SIZED FOR ONE SHARED KEY, NOT FOR ONE CLIENT.
# Behind Caddy (`deploy/Caddyfile.relay`) every peer is 127.0.0.1 — `server.ts`
# keys its limiter on Bun's `requestIP`, the DIRECT peer — so
# `--max-dials-per-minute`, `--max-streams-per-ip` and `--max-hellos-per-minute`
# are ONE bucket for the whole world. Left at their per-client defaults (30 / 16
# / 10) this unit would cap every phone on the relay at 16 sockets, let any single
# client lock every phone out, and admit 10 daemon `hello`s/min globally — a
# 200-daemon fleet after a restart would take ~20 minutes to re-register, which is
# the thundering herd F3 promises the relay does NOT have. So the fleet sizes are
# live here, not a commented-out example (`deploy.test.ts` holds each above its
# per-client default and pins the values):
#   6000/min dials = 100/s        (a phone dials on each reconnect; F1/F2 resync)
#   2000 concurrent phone sockets (a fleet, with headroom)
#   600/min hellos = 10/s         (200 daemons re-register in ~20 s, jittered F3)
# A flood is bounded by MemoryMax below, i.e. it costs the relay's own memory and
# never the host's. When the relay learns X-Forwarded-For behind a trusted-local
# flag (a code change, its own task) these become per-client again and must drop
# back to the per-client defaults of `relay-core.ts`.
ExecStart=/opt/tentacle-relay/tentacle-relay --host 127.0.0.1 --port 4100 \
    --max-dials-per-minute 6000 --max-streams-per-ip 2000 --max-hellos-per-minute 600

# PUSH IS NOT WIRED HERE (docs/feat/mobile-push.md P10, review round 1 finding 1).
# The four `--apns-*` flags, the `EnvironmentFile` and the `LoadCredential` live in
# `relay.service.d/apns.conf`, which the runbook installs ONLY together with the
# `.p8` (§6.1). Both of those settings make a unit UNABLE TO START on a host where
# the key is not installed, which is not what "push is optional" may mean:
#  - `LoadCredential=ID:/absolute/path` fails the unit's start when that file is
#    missing (exit 243/CREDENTIALS) — it does not degrade to "no credential";
#  - an unset `${VAR}` is expanded by systemd to an EMPTY ARGUMENT (systemd.service(5):
#    "treated as empty strings", and a `${VAR}` word is always exactly one argument).
# With `Restart=always` either one is a crash loop that takes every phone off the
# relay because Apple's key was absent. `main.ts` now treats a blank `--apns-*`
# value as "not set", so the second is survivable — but the first is not ours to
# soften, so the wiring simply does not belong in this file.
# The base unit therefore serves with push off — one `push off:` line, no `push` in
# `ready.features` — which is exactly what F4 promises.

Restart=always
RestartSec=2s
TimeoutStopSec=10s

# Sandbox. The relay serves sockets and writes nothing: no state, no session, no
# secret (Owner Q4). So every write path can be closed, and the service keeps no
# capability at all (it binds loopback on a port > 1024).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
# NOT set, deliberately: MemoryDenyWriteExecute and SystemCallFilter=@system-service.
# The binary is Bun, i.e. JavaScriptCore, which JIT-compiles — it maps
# writable-then-executable memory by design. `MemoryDenyWriteExecute=yes` would
# make the relay die on its first compiled frame, and a syscall allowlist tuned on
# a non-JIT service tends to block the same thing (membarrier). Both are the kind
# of hardening that looks good in a unit and breaks the service on the host only.

# One process, bounded: a hostile flood costs the relay's own memory, never the
# host's (the per-IP and per-id limits are the real bound — `relay-core.ts`; this
# is the last resort).
MemoryMax=512M
TasksMax=512

# The journal is the only log. One line per event, id prefixes only, never a
# secret or a payload (`apps/relay/src/server.ts`).
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tentacle-relay

[Install]
WantedBy=multi-user.target
