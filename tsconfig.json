{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Root project: type-checks the whole monorepo in one pass (`tsc --noEmit`).
  // Bun resolves workspace packages at runtime via symlinks; these `paths`
  // let `tsc` resolve the same `@tentacle/*` specifiers for type-checking.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "types": ["bun", "react"],
    "paths": {
      "@tentacle/protocol": ["packages/protocol/src/index.ts"],
      "@tentacle/config": ["packages/config/src/index.ts"],
      "@tentacle/core": ["packages/core/src/index.ts"],
      "@tentacle/providers": ["packages/providers/src/index.ts"],
      "@tentacle/exec": ["packages/exec/src/index.ts"],
      "@tentacle/tools": ["packages/tools/src/index.ts"],
      "@tentacle/mcp": ["packages/mcp/src/index.ts"],
      "@tentacle/agent": ["packages/agent/src/index.ts"],
      "@tentacle/transport": ["packages/transport/src/index.ts"],
      "@tentacle/daemon": ["packages/daemon/src/index.ts"],
      "@tentacle/client": ["packages/client/src/index.ts"],
      "@tentacle/cli": ["packages/cli/src/index.ts"],
      "@tentacle/tui": ["packages/tui/src/index.ts"],
      "@tentacle/k8s": ["packages/k8s/src/index.ts"],
      "@tentacle/docker": ["packages/docker/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "packages/*/test/**/*.ts",
    "packages/*/test/**/*.tsx",
    "scripts/**/*.ts"
  ]
}
