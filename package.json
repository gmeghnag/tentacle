{
  "name": "tentacle",
  "version": "0.7.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p apps/mobile --noEmit && tsc -p apps/relay --noEmit && tsc -p apps/apps-host --noEmit",
    "test": "bun test --parallel --timings=scripts/test-timings.json",
    "test:timings": "bun test --parallel --timings=scripts/test-timings.json --update-timings && biome format --write scripts/test-timings.json",
    "test:watch": "bun test --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "bun run typecheck && bun run lint && bun run test",
    "schema:export": "bun packages/protocol/src/json-schema.ts && biome format --write packages/protocol/schema/protocol.json",
    "protocol:bump": "bun scripts/protocol-bump.ts",
    "mockup-kit": "bun scripts/mockup-kit.ts gen",
    "docs:config": "bun scripts/config-docs.ts",
    "badges": "bun scripts/coverage-badges.ts",
    "e2e:mobile": "bun apps/mobile/e2e/run.ts",
    "compile": "bun run scripts/build.ts",
    "browser-extension:pack": "bun scripts/browser-extension-pack.ts",
    "voice:build": "bun run scripts/voice-build.ts",
    "voice:test": "swift test --package-path native/voice-mac",
    "release": "bun run scripts/release.ts",
    "test:swift": "cd apps/mobile/native-tests/PushCoreTests && swift test"
  },
  "dependencies": {
    "react-devtools-core": "file:./stubs/react-devtools-core"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/bun": "1.1.14",
    "@types/react": "18.3.12",
    "typescript": "5.7.2"
  }
}
