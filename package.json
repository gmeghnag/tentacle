{
  "name": "tentacle",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p apps/mobile",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "bun run typecheck && bun run lint && bun run test",
    "schema:export": "bun packages/protocol/src/json-schema.ts && biome format --write packages/protocol/schema/protocol.json",
    "compile": "bun run scripts/build.ts",
    "release": "bun run scripts/release.ts"
  },
  "dependencies": {
    "react-devtools-core": "file:./stubs/react-devtools-core"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/bun": "1.1.14",
    "@types/react": "18.3.12",
    "typescript": "5.7.2"
  }
}
