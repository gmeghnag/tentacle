{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "organizeImports": { "enabled": true },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noNonNullAssertion": "warn",
        "useImportType": "error"
      },
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "quoteStyle": "double", "trailingCommas": "all", "semicolons": "always" }
  },
  "files": {
    "ignore": ["node_modules", "dist", "**/*.tsbuildinfo", "coverage", "stubs"]
  },
  "overrides": [
    {
      "include": ["**/tsconfig*.json", "**/*.jsonc"],
      "json": { "parser": { "allowComments": true, "allowTrailingCommas": true } }
    },
    {
      "include": ["packages/tui/**"],
      "linter": { "rules": { "suspicious": { "noArrayIndexKey": "off" } } }
    }
  ]
}
