# Dependencies (no trailing slash: a worktree's `node_modules` SYMLINK must match too)
node_modules

# Build output
dist/
# SwiftPM's build products (the voice helper; `bun run voice:build`).
native/voice-mac/.build/
*.tsbuildinfo

# Test / coverage
coverage/

# Environment & secrets
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
*.log

# Agent workspace artifacts (tool-output spills, sessions)
# `/*` + the exception, because git cannot re-include a child of an excluded
# DIRECTORY: the project's workflows (`.tentacle/workflows/`) ARE versioned
# (docs/feat/workflows-ui.md D7 v5), everything else under `.tentacle/` is not.
.tentacle/*
!.tentacle/workflows/
.harness/


# Expo app: generated native projects (CNG) and Expo state
apps/mobile/ios/
apps/mobile/android/
apps/mobile/.expo/
# `expo prebuild` writes this when the widget target has none; main never tracked it
# (docs/feat/mobile-chrome.md S1 note + S6 Review finding 1).
apps/mobile/targets/live-activity/Info.plist
# SwiftPM's build products for the NSE's test package (docs/feat/mobile-notifications.md N5)
apps/mobile/native-tests/PushCoreTests/.build/
.playwright-mcp/
